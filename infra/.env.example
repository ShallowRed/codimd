# CodiMD infra — copier vers .env et remplir. NE PAS COMMITER .env.

# Domaine (DNS doit pointer vers le VPS)
CMD_DOMAIN=codimd.lucaspoulain.com

# Base de données
DB_DATABASE=codimd
DB_USER=codimd
# openssl rand -base64 24
DB_PASSWORD=CHANGE_ME

# Secret de session — openssl rand -hex 32
CMD_SESSION_SECRET=CHANGE_ME

# Permissions (reprises de la config Scalingo)
CMD_ALLOW_ANONYMOUS=true
CMD_ALLOW_ANONYMOUS_EDITS=true
CMD_DEFAULT_PERMISSION=editable
